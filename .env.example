# =============================================================
# MiroFish-Offline Configuration
# =============================================================
# This fork runs entirely on local models — no cloud APIs needed.
# Copy this file to .env and adjust values for your setup.
#
# Pick exactly ONE backend profile below. Uncomment the whole block you
# want and comment out the other one — they set the same variables.
# =============================================================


# =============================================================
# PROFILE: Ollama  (active by default)
# =============================================================
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:32b
LLM_API_STYLE=ollama

# Ollama's own default context is only 2048, which truncates prompts.
# Applies to this profile only.
OLLAMA_NUM_CTX=8192

EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_STYLE=ollama

# CAMEL-AI reads these directly, so they must track LLM_BASE_URL.
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1


# =============================================================
# PROFILE: llama.cpp
# =============================================================
# Needs two servers running — see README "Option B: Manual".
# Chat and embeddings cannot share one server, because --embeddings
# restricts a server to embedding use only.

# LLM_API_KEY=llamacpp
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL_NAME=qwen2.5-32b-instruct
# LLM_API_STYLE=openai

# No OLLAMA_NUM_CTX here: context is a launch flag, not a request
# parameter. Use "-np N --kv-unified-per-slot M" on the chat server to
# give each of the N slots M tokens. Keep M at 16384 or above: the
# report agent overflows an 8192 slot and fails the whole report.

# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://localhost:8081
# EMBEDDING_API_STYLE=openai

# Only needed if the embedding server runs with --api-key. Note llama.cpp
# also picks that up from the LLAMA_API_KEY environment variable, so a
# server can require a key without being launched with the flag.
# EMBEDDING_API_KEY=

# OPENAI_API_KEY=llamacpp
# OPENAI_API_BASE_URL=http://localhost:8080/v1


# =============================================================
# Shared settings (both profiles)
# =============================================================

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Simulation concurrency =====
# Max concurrent LLM requests per platform environment. Twitter and Reddit
# run in parallel, so peak in-flight requests is roughly twice this value.
# With llama.cpp, keep it in line with the chat server's -np slot count.
OASIS_LLM_SEMAPHORE=30

# ===== Notes on the API style settings =====
# LLM_API_STYLE / EMBEDDING_API_STYLE select the wire format:
#   ollama -> sends Ollama's num_ctx option; POST {EMBEDDING_BASE_URL}/api/embed
#   openai -> sends no extra fields;         POST {EMBEDDING_BASE_URL}/v1/embeddings
# Use 'openai' for llama.cpp, OpenAI and Anthropic. If LLM_API_STYLE is
# unset the style is guessed from the port in LLM_BASE_URL.
# Note LLM_BASE_URL ends in /v1 but EMBEDDING_BASE_URL does not — the
# embedding path is appended for you.


# =============================================================
# Docker-mode overrides
# =============================================================
# Containers reach each other by service name, not localhost. Apply these
# on top of whichever profile you chose.
#
# Both profiles:
# NEO4J_URI=bolt://neo4j:7687
#
# With --profile ollama:
# LLM_BASE_URL=http://ollama:11434/v1
# EMBEDDING_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=http://ollama:11434/v1
#
# With --profile llamacpp:
# LLM_BASE_URL=http://llamacpp-chat:8080/v1
# EMBEDDING_BASE_URL=http://llamacpp-embed:8081
# OPENAI_API_BASE_URL=http://llamacpp-chat:8080/v1


# =============================================================
# llama.cpp container images and models
# =============================================================
# Used only by "docker compose --profile llamacpp".
# Swap :server-cuda for :server (CPU), :server-rocm, :server-vulkan or
# :server-intel to match your hardware.
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# Same model as the Ollama profile (qwen2.5:32b). Needs about 36GB of VRAM at
# -np 4 --kv-unified-per-slot 16384 (20GB weights + 16GB KV), so it will not fit
# a 24GB card. Use bartowski/Qwen2.5-14B-Instruct-GGUF:Q4_K_M (~21GB) there and
# set LLM_MODEL_NAME to match the server's --alias.
LLAMACPP_CHAT_MODEL=bartowski/Qwen2.5-32B-Instruct-GGUF:Q4_K_M
LLAMACPP_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF:Q8_0
